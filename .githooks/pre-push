#!/usr/bin/env sh
# ==============================================================================
# ReferenceRAG Pre-push Version & Release Gatekeeper Hook
# ==============================================================================

remote_name="$1"
remote_url="$2"

has_tag_push=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # 忽略删除引用的推送
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    case "$local_ref" in
        refs/tags/*)
            tag_name="${local_ref#refs/tags/}"
            has_tag_push=1
            echo ""
            echo "=========================================================="
            echo "  [GitVersionGate] 检测到版本标签推送: $tag_name"
            echo "=========================================================="
            
            # 校验是否遵循语义化标签命名规范 (vX.Y.Z)
            case "$tag_name" in
                v[0-9]*.[0-9]*.[0-9]*)
                    echo "  [✓] 标签命名符合规范 (vMajor.Minor.Patch)"
                    ;;
                v[0-9]*.[0-9]*)
                    echo "  [✓] 标签命名符合规范 (vMajor.Minor)"
                    ;;
                *)
                    echo "  [!] 提示: 标签 '$tag_name' 未遵循 'v' 前缀或语义化格式 (建议如 v1.0.52)。"
                    echo "      建议遵循语义化规范，以便 MSBuild 动态版本提取与 CI 识别。"
                    ;;
            esac
            
            # 检查工作区纯净度，防呆提醒
            if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
                echo "  [!] 提醒: 检测到当前工作区存在未提交的修改。"
                echo "      请注意：未提交的代码不会包含在推送的标签 Commit 中。"
            fi
            
            echo "  [✓] Directory.Build.props 已挂载 Git 动态版本注入 Target。"
            echo "      本地打包 (build-desktop.bat) 与 CI 产物版本将自动锁定为该标签。"
            echo "=========================================================="
            echo ""
            ;;
    esac
done

exit 0
