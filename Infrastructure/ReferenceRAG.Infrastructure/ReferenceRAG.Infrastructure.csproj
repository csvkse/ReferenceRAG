<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><RootNamespace>ReferenceRAG.Core</RootNamespace></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="jieba.NET" GeneratePathProperty="true" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Rougamo.Fody" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="BERTTokenizers" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Tokenizers.HuggingFace" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.SqliteVec" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <!-- 通用版 (默认): 支持 AMD / Intel / NVIDIA / 高通骁龙 全系列显卡 (DirectML + Vulkan) -->
  <ItemGroup Condition="'$(GpuBackend)' == '' or '$(GpuBackend)' == 'universal' or '$(GpuBackend)' == 'directml'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>

  <!-- NVIDIA 专属满血版: 针对 GeForce RTX / GTX 独显优化 (CUDA 12 + TensorRT) -->
  <ItemGroup Condition="'$(GpuBackend)' == 'nvidia' or '$(GpuBackend)' == 'cuda'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12.Windows" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>

  <!-- AMD 专属优化版: 针对 AMD Radeon 独显与 Ryzen/APU 核显优化 (DirectML + Vulkan) -->
  <ItemGroup Condition="'$(GpuBackend)' == 'amd' or '$(GpuBackend)' == 'rocm' or '$(GpuBackend)' == 'radeon'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>

  <!-- Intel 专属优化版: 针对 Intel Arc 独显与酷睿 Ultra 核显优化 (DirectML + Vulkan) -->
  <ItemGroup Condition="'$(GpuBackend)' == 'intel' or '$(GpuBackend)' == 'openvino' or '$(GpuBackend)' == 'arc'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>

  <!-- 纯 CPU 兼容版: 针对无独显轻量级环境 (纯 CPU AVX2) -->
  <ItemGroup Condition="'$(GpuBackend)' == 'cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(Pkgjieba_NET)\Resources\**\*.*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
