{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ReferenceRAG": "Information"
    }
  },
  "AllowedHosts": "*",
  "SwaggerEnabled": true,
  "ReferenceRAG": {
    "schemaVersion": 2,
    "dataPath": "data",
    "modelsRootPath": "models",
    "sources": [],
    "embedding": {
      "modelPath": "",
      "modelName": "bge-small-zh-v1.5",
      "maxSequenceLength": 512,
      "batchSize": 64,
      "modelsPath": "models",
      "acceleration": {
        "backend": "DirectML",
        "deviceId": 0
      }
    },
    "chunking": {
      "maxTokens": 512,
      "minTokens": 50,
      "overlapTokens": 50,
      "preserveHeadings": true,
      "preserveCodeBlocks": true
    },
    "search": {
      "topK": 5,
      "minScore": 0.3,
      "enableBM25": true,
      "enableVector": true,
      "hybridWeight": 0.7
    },
    "service": {
      "enableHttpService": false,
      "allowNetworkAccess": false,
      "port": "7897",
      "corsOrigins": [
        "*"
      ],
      "rateLimit": {
        "permitLimit": 100,
        "windowSeconds": 60
      }
    },
    "rerank": {
      "modelPath": "",
      "modelName": "bge-reranker-base",
      "topN": 5,
      "enabled": false,
      "modelsPath": "models",
      "acceleration": {
        "backend": "DirectML",
        "deviceId": 0
      }
    },
    "indexing": {
      "autoIndex": false,
      "watchInterval": 60,
      "fileExtensions": [
        ".md",
        ".txt"
      ]
    },
    "modelHub": {
      "hfEndpoint": "https://hf-mirror.com",
      "hfToken": "",
      "connectTimeoutSeconds": 15,
      "readTimeoutSeconds": 60
    },
    "chat": {
      "activeBackend": "OpenAiApi",
      "openAiApi": {
        "endpoint": "https://api.openai.com/v1",
        "apiKey": "",
        "model": "gpt-4o-mini",
        "timeoutSeconds": 60
      },
      "localGguf": {
        "modelName": "Qwen2.5-7B-Instruct-GGUF",
        "modelPath": "",
        "gpuLayers": -1,
        "contextSize": 4096
      },
      "systemPrompt": "你是 ReferenceRAG 智能助手，能够结合本地知识库为用户提供专业、准确的回答。",
      "maxSessions": 100,
      "maxMessagesPerSession": 50,
      "sessionIdleMinutes": 60
    },
    "desktop": {
      "enableLocalApi": false,
      "minimizeToTray": true,
      "autoStart": false
    }
  }
}
