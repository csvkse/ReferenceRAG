# syntax=docker/dockerfile:1
# ============================================================
# ReferenceRAG - NVIDIA GPU (CUDA 12.8 + cuDNN 9) Dockerfile
# 说明：本镜像专为 NVIDIA 独立显卡打造，依赖 nvidia-container-toolkit
# 运行示例：docker run --gpus all -p 5123:5000 ghcr.io/csvkse/referencerag:cuda
# ============================================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Stage 1: Restore dependencies (cached independently of source code changes)
COPY Directory.Build.props Directory.Packages.props ./
COPY Infrastructure/ReferenceRAG.Infrastructure/ReferenceRAG.Infrastructure.csproj ./Infrastructure/ReferenceRAG.Infrastructure/
COPY Business/ReferenceRAG.Business/ReferenceRAG.Business.csproj ./Business/ReferenceRAG.Business/
COPY Host/ReferenceRAG.ApiHost/ReferenceRAG.ApiHost.csproj ./Host/ReferenceRAG.ApiHost/
COPY Host/ReferenceRAG.WebHost/ReferenceRAG.WebHost.csproj ./Host/ReferenceRAG.WebHost/
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages \
    dotnet restore Host/ReferenceRAG.WebHost/ReferenceRAG.WebHost.csproj -p:GpuBackend=cuda

# Stage 2: Build & Publish (prune Windows/macOS native runtimes to shrink Linux image)
COPY Infrastructure/ ./Infrastructure/
COPY Business/ ./Business/
COPY Host/ReferenceRAG.ApiHost/ ./Host/ReferenceRAG.ApiHost/
COPY Host/ReferenceRAG.WebHost/ ./Host/ReferenceRAG.WebHost/
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages \
    dotnet publish Host/ReferenceRAG.WebHost/ReferenceRAG.WebHost.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:GpuBackend=cuda \
    /p:UseAppHost=false \
    /p:DebugType=none \
    /p:DebugSymbols=false \
    && rm -rf /app/publish/runtimes/win* /app/publish/runtimes/osx*

# Official ASP.NET Core 10.0 runtime stage for zero-download binary copy
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS dotnet-runtime

# ============================================================
# Stage 3: Runtime (NVIDIA CUDA 12.8 + cuDNN 9)
# ============================================================
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04 AS runtime
WORKDIR /app

# Install native dependencies required by .NET 10 and ONNX runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    libgomp1 \
    libicu74 \
    libssl3t64 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy .NET 10 ASP.NET Core runtime directly from official image
COPY --from=dotnet-runtime /usr/share/dotnet /usr/share/dotnet
RUN ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet

# Create directories and non-root user
RUN mkdir -p /app/data /app/models /app/logs \
    && groupadd -r appgroup \
    && useradd -r -g appgroup appuser \
    && chown -R appuser:appgroup /app

# Copy published application
COPY --from=build /app/publish .
COPY support/config/examples/appsettings.Docker.example.json ./appsettings.json

# Environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DataPath=/app/data
ENV LogsPath=/app/logs
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV CUDA_VISIBLE_DEVICES=0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/system/health || exit 1

USER appuser

EXPOSE 5000

ENTRYPOINT ["dotnet", "ReferenceRAG.WebHost.dll"]
