# syntax=docker/dockerfile:1
# ReferenceRAG: Intel GPU Native Acceleration (Level Zero / OpenCL)
# Target: Intel Arc Discrete GPUs, Intel Core Ultra (Meteor Lake / Lunar Lake / Arrow Lake), 11th-14th Gen Core Iris Xe & UHD Graphics

# ------------------------------------------------------------
# Stage 1: Extract ASP.NET Core Runtime from official image
# ------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS dotnet-runtime

# ------------------------------------------------------------
# Stage 2: Extract OpenVINO-enabled ONNX Runtime from official Linux wheel
# ------------------------------------------------------------
FROM python:3.12-slim AS openvino-extract
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir onnxruntime-openvino==1.24.1
RUN mkdir -p /extracted && \
    find /usr/local/lib/python3.12/site-packages -name "*.so*" -exec cp -d {} /extracted/ \; && \
    cd /extracted && \
    for f in libonnxruntime.so.*; do \
        if [ -f "$f" ]; then \
            ln -sf "$f" libonnxruntime.so; \
            ln -sf "$f" libonnxruntime.so.1; \
            break; \
        fi; \
    done && \
    ls -la /extracted && \
    LD_LIBRARY_PATH=/extracted python3 -c "import ctypes; lib = ctypes.CDLL('/extracted/libonnxruntime.so'); print('libonnxruntime loaded successfully:', lib); assert hasattr(lib, 'OrtSessionOptionsAppendExecutionProvider_OpenVINO'), 'Missing OrtSessionOptionsAppendExecutionProvider_OpenVINO symbol in extracted libonnxruntime.so'"

# ------------------------------------------------------------
# Stage 3: Build & Publish
# ------------------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props ./
COPY Infrastructure/ReferenceRAG.Infrastructure/ReferenceRAG.Infrastructure.csproj ./Infrastructure/ReferenceRAG.Infrastructure/
COPY Business/ReferenceRAG.Business/ReferenceRAG.Business.csproj ./Business/ReferenceRAG.Business/
COPY Host/ReferenceRAG.ApiHost/ReferenceRAG.ApiHost.csproj ./Host/ReferenceRAG.ApiHost/
COPY Host/ReferenceRAG.WebHost/ReferenceRAG.WebHost.csproj ./Host/ReferenceRAG.WebHost/
RUN dotnet restore Host/ReferenceRAG.WebHost/ReferenceRAG.WebHost.csproj -p:GpuBackend=openvino

COPY Infrastructure/ ./Infrastructure/
COPY Business/ ./Business/
COPY Host/ReferenceRAG.ApiHost/ ./Host/ReferenceRAG.ApiHost/
COPY Host/ReferenceRAG.WebHost/ ./Host/ReferenceRAG.WebHost/
COPY support/config/appsettings.template.json ./support/config/
RUN dotnet publish Host/ReferenceRAG.WebHost/ReferenceRAG.WebHost.csproj \
    -c Release \
    -o /app/publish \
    /p:GpuBackend=openvino \
    /p:UseAppHost=false \
    /p:DebugType=none \
    /p:DebugSymbols=false \
    && rm -rf /app/publish/runtimes/win* /app/publish/runtimes/osx* \
    && rm -f /app/publish/runtimes/linux-x64/native/libonnxruntime*

# ============================================================
# Stage 4: Runtime (Intel Compute Runtime / Level Zero & OpenCL)
# ============================================================
FROM ubuntu:24.04 AS runtime
WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

# Install prerequisites, curl, gpg, .NET dependencies, and gosu for root privilege drop
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    wget \
    libgomp1 \
    libicu74 \
    libssl3t64 \
    libvulkan1 \
    mesa-vulkan-drivers \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Add Intel Graphics official repository & install Level Zero GPU runtime
RUN mkdir -p /usr/share/keyrings \
    && wget -qO - https://repositories.intel.com/gpu/intel-graphics.key | gpg --yes --dearmor --output /usr/share/keyrings/intel-graphics.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu noble unified" > /etc/apt/sources.list.d/intel-gpu.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        intel-opencl-icd \
        libze-intel-gpu1 \
        libze1 \
    && rm -rf /var/lib/apt/lists/*

# Copy .NET 10 ASP.NET Core runtime directly from official image
COPY --from=dotnet-runtime /usr/share/dotnet /usr/share/dotnet
RUN ln -s /usr/share/dotnet/dotnet /usr/bin/dotnet

# Create directories, compatibility symlink, and non-root user (ensure video & render groups exist for DRI access)
RUN mkdir -p /app/data /app/models /app/logs \
    && ln -sf /app/logs /app/Logs \
    && groupadd -r appgroup \
    && (getent group video || groupadd -r video) \
    && (getent group render || groupadd -r render) \
    && useradd -r -g appgroup -G video,render appuser \
    && chown -R appuser:appgroup /app

# Copy published application and entrypoint script
COPY --from=build /app/publish .
COPY support/deploy/docker/docker-entrypoint.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh
COPY support/config/examples/appsettings.Docker.example.json ./appsettings.json

# Clean any residual CPU-only ONNX Runtime libraries before overlaying OpenVINO binaries
RUN rm -f /app/runtimes/linux-x64/native/libonnxruntime* /app/libonnxruntime*

# Overlay OpenVINO-enabled ONNX Runtime shared libraries
COPY --from=openvino-extract /extracted/ /app/runtimes/linux-x64/native/
COPY --from=openvino-extract /extracted/ /app/

RUN cd /app/runtimes/linux-x64/native && \
    for f in libonnxruntime.so.*; do \
        if [ -f "$f" ]; then \
            ln -sf "$f" libonnxruntime.so; \
            ln -sf "$f" libonnxruntime.so.1; \
            break; \
        fi; \
    done && \
    cd /app && \
    for f in runtimes/linux-x64/native/libonnxruntime.so.*; do \
        if [ -f "$f" ]; then \
            ln -sf "$f" libonnxruntime.so; \
            ln -sf "$f" libonnxruntime.so.1; \
            break; \
        fi; \
    done

RUN echo "/app/runtimes/linux-x64/native" > /etc/ld.so.conf.d/openvino.conf \
    && echo "/app" >> /etc/ld.so.conf.d/openvino.conf \
    && ldconfig

ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DataPath=/app/data
ENV LogsPath=/app/logs
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV ONEAPI_DEVICE_SELECTOR=level_zero:gpu
ENV LIBVA_DRIVER_NAME=iHD
ENV LD_LIBRARY_PATH="/app:/app/runtimes/linux-x64/native:/usr/lib/x86_64-linux-gnu"

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/system/health || exit 1

EXPOSE 5000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["dotnet", "ReferenceRAG.WebHost.dll"]
