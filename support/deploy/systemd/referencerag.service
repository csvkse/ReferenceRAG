# ==============================================================================
# ReferenceRAG Native Linux Systemd Unit File
# ==============================================================================
# Installation:
#   1. sudo cp referencerag.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable --now referencerag
#   4. sudo systemctl status referencerag
# ==============================================================================

[Unit]
Description=ReferenceRAG Enterprise Private Hybrid Retrieval & Indexing Engine
Documentation=https://github.com/csvkse/ReferenceRAG
After=network.target

[Service]
Type=simple
User=referencerag
Group=referencerag
WorkingDirectory=/opt/referencerag
ExecStart=/usr/bin/dotnet /opt/referencerag/ReferenceRAG.WebHost.dll
Restart=on-failure
RestartSec=10

# Security & Process Sandbox Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/referencerag /var/log/referencerag

# Service Environment Variables
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://0.0.0.0:5123
Environment=DataPath=/var/lib/referencerag/data
Environment=LogsPath=/var/log/referencerag
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
# Dynamic runtime library paths for ONNX Runtime, Vulkan, and CUDA
Environment=LD_LIBRARY_PATH=/opt/referencerag:/opt/referencerag/runtimes/linux-x64/native:/usr/local/cuda/lib64

# Resource limits for high-concurrency vector search & large SQLite databases
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
